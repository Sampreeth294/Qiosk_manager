cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.coverage

# Virtual environments
venv/
.venv/
backend/venv/
backend/.venv/

# Environment variables and secrets
.env
.env.*
!.env.example

# Django
*.sqlite3
media/
staticfiles/

# Node
node_modules/
frontend/node_modules/
frontend/dist/

# Editors and operating system
.vscode/
.idea/
.DS_Store
